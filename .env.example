# ============================================================
# AIC2026-Multimedia-Agent — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit your `.env` file to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=AIC2026-Multimedia-Agent
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── FastAPI Backend ──────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1
CORS_ORIGINS=["http://localhost:8501"]

# ── Qdrant (Vector Database) ────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=aic2026_keyframes
QDRANT_VECTOR_SIZE=512

# ── Elasticsearch (Sparse Search) ───────────────────────────
ES_HOST=localhost
ES_PORT=9200
ES_INDEX_OCR=aic2026_ocr
ES_INDEX_ASR=aic2026_asr
ES_INDEX_OBJECTS=aic2026_objects
ES_INDEX_METADATA=aic2026_metadata

# ── Model Paths ──────────────────────────────────────────────
SIGLIP2_MODEL_ID=ViT-gopt-16-SigLIP2-384
SIGLIP2_PRETRAINED=webli
SIGLIP2_WEIGHTS_PATH=./models/open_clip_model.safetensors
SIGLIP2_DEVICE=cuda
OPENCLIP_MODEL_ID=ViT-B-32-quickgelu
OPENCLIP_PRETRAINED=openai
OPENCLIP_DEVICE=cuda
QWEN_VL_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
GROUNDING_DINO_MODEL_ID=IDEA-Research/grounding-dino-base

# ── LLM Agent ────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=o1-mini

# ── Data Paths ───────────────────────────────────────────────
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_INDEX_DIR=./data/index
DATA_MOCK_DIR=./data/mock
KEYFRAMES_DIR=./data/raw/keyframes

# ── VRAM Budget ──────────────────────────────────────────────
MAX_VRAM_GB=8
RERANK_TOP_K=50
DEEP_REASONING_TOP_K=5

# ── RRF Fusion ───────────────────────────────────────────────
RRF_K=60
